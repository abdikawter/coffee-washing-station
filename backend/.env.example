# ---------------------------------------------------------------------------
# Coffee Washing Station API — environment. Copy to .env (never commit .env).
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Render sits behind one proxy hop; needed for correct client IPs and rate limiting.
TRUST_PROXY=1

# PostgreSQL (Render: use the *Internal* Database URL for the web service)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/cws_dev
# true on Render external connections / managed databases that require TLS
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# Auth — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
JWT_ISSUER=cws-api
# Frontend origins allowed by CORS (comma separated)
CORS_ORIGINS=http://localhost:5173
# Refresh-token cookie. Frontend and API on different *.onrender.com hosts are cross-site:
# use SameSite=none + secure=true. With a shared custom domain (app.x.com / api.x.com) use strict.
REFRESH_COOKIE_SAMESITE=lax
REFRESH_COOKIE_SECURE=false

# File storage: local (dev) or s3 (any S3-compatible service: AWS S3, Cloudflare R2, Backblaze B2, MinIO)
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./storage
MAX_UPLOAD_MB=10
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# Background jobs (pg-boss). true = run the worker inside the web process (single Render
# Web Service). Set false when a separate Render Background Worker runs `npm run start:worker`.
RUN_WORKER_IN_PROCESS=true

# Swagger UI at /api/docs (the OpenAPI JSON is always at /api/docs/openapi.json)
SWAGGER_ENABLED=true

# First-run seed: creates the initial SUPER_ADMIN only when no SUPER_ADMIN exists.
# The password must be changed at first login.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_FULL_NAME=System Administrator
SEED_ADMIN_PASSWORD=
